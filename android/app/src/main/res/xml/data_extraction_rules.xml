<?xml version="1.0" encoding="utf-8"?>
<!-- Kos TV: the sign-in tokens of everyone in the family live in the app's
     data, so none of it goes into cloud backups or a transfer to another
     device (Android 12 and later; older ones follow allowBackup). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

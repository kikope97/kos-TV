# Variables de kOS TV para compose.yml. Copia este archivo como .env y
# rellénalo. El .env se queda en el servidor: no lo subas a ningún sitio.

# El Jellyfin de casa tal como lo abre el navegador (público, con https).
KOSTV_SERVER_URL=https://jellyfin.example.com

# Opcional: la dirección de Stremfin se pone en el complemento de Jellyfin.
# Solo mientras Stremfin no acepte llamadas de la web (CORS), el servicio de
# peticiones tal como lo alcanza el contenedor (que lo pasa en /stremfin).
# KOSTV_REQUESTS_URL=https://peticiones.example.com

# Usuario y contraseña del panel de administración (/admin).
# Sin contraseña, /admin queda cerrado. Usa al menos 10 caracteres.
KOSTV_ADMIN_USER=admin
KOSTV_ADMIN_PASSWORD=
